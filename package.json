{
  "name": "nakshtra",
  "version": "0.1.0",
  "private": true,
  "description": "Nakshtra - Astrology platform: mobile + web app, expert chat with SLA, video consulting, admin panel",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm run start --workspace apps/mobile",
    "mobile:web": "npm run web --workspace apps/mobile",
    "admin": "npm run dev --workspace apps/admin",
    "admin:build": "npm run build --workspace apps/admin",
    "test": "npm test --workspace packages/shared"
  },
  "engines": {
    "node": ">=20"
  }
}
